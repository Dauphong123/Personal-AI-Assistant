{
  "name": "coding-assistant-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "TypeScript browser frontend for the coding assistant; talks to python -m backend.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-public.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "watch": "tsc -p tsconfig.build.json --watch"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3"
  }
}
