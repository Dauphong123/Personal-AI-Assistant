# Copy to .env and adjust. .env is gitignored.
MODEL=qwen3:8b
# SUMMARY_MODEL=qwen3:4b
DB_URL=postgresql://agent:agent_password@localhost:5432/agent_memory
# LLM_REASONING=false    # true = let the model "think" first: smarter but several times slower
# LLM_KEEP_ALIVE=30m     # how long Ollama keeps the model loaded after a message
# LLM_NUM_CTX=           # context window; empty = Ollama default. Smaller = faster and less memory
# MAX_HISTORY_TOKENS=5000  # history is summarized above this; keep it below LLM_NUM_CTX minus ~3000
# WEB_SEARCH_ENABLED=true  # false = the agent cannot search the web or open web pages (queries go to DuckDuckGo when on)
# PROJECT_ROOT=   # directory the coding tools may touch (default: this repo)

# --- Voice mode (python main.py --voice, needs requirements_voice.txt) ---
# VOICE_ENABLED=false
# WAKE_WORD=hey_jarvis              # built-in openWakeWord model (alexa, hey_mycroft, hey_jarvis, hey_rhasspy, timer, weather) or path to a custom .onnx
# WAKE_WORD_THRESHOLD=0.5           # 0.05-1.0; raise it if it triggers by accident
# SPEECH_RECOGNITION_MODEL=base     # faster-whisper model (tiny, base, small, ...)
# SPEECH_LANGUAGE=en                # en | vi | "vi,en" (detects which, among just those) | auto. Non-English picks the "small" Whisper model
# TTS_VOICE=en_US-lessac-medium     # Piper voice name; downloaded on first use
# TTS_VOICE_VI=vi_VN-vais1000-medium # voice for replies written in Vietnamese
# VOICE_LISTENING_TIMEOUT=10        # seconds to wait for you to start speaking
# VOICE_MAX_RECORDING_DURATION=60
# MICROPHONE_DEVICE=                # device index or name; empty = system default
# AUDIO_OUTPUT_DEVICE=
# SPEAKER_VERIFICATION=             # empty = on automatically once you ran `python -m voice.enroll`; true/false to force
# SPEAKER_THRESHOLD=                # 0.1-0.95; empty = calibrated at enrollment. Raise = stricter. Tune with `python -m voice.enroll --test`
# VOICEPRINT_PATH=                  # default: <VOICE_MODEL_DIR>/voiceprint.npz
